+    fn quotes_group_words_and_escapes_work() {
+        assert_eq!(tokenize("inject text \"hello  world\" --at 3 4").unwrap(), ["inject", "text", "hello  world", "--at", "3", "4"]);
+        assert_eq!(tokenize("a \"b \\\"c\\\"\" d").unwrap(), ["a", "b \"c\"", "d"]);
+        assert_eq!(tokenize("   ").unwrap(), Vec::<String>::new());
+        assert_eq!(tokenize("x \"\"").unwrap(), ["x", ""]);
