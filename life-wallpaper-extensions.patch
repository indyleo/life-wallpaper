+    /// Live cells lift towards white.
+    pub brighten: f32,
+    /// Extra halo around live cells.
+    pub glow: f32,
+    /// Faint tint of the background.
+    pub bg: f32,
+    /// Short beat flash (lifts live cells and the background a little).
+    pub flash: f32,
