+        assert_eq!(s.life.population(), pop, "beat right after an event");
+        // an ungated injection (--once) ignores the clock
+        let mut s = Sim::new(120, 80, t0, &cfg);
+        s.life.clear();
+        s.on_beat(0.3, t0);
