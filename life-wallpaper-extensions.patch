+    fn every_command_parses() {
+        assert_eq!(parse("stats"), Ok(Command::Stats));
+        assert_eq!(parse("PAUSE"), Ok(Command::Pause));
+        assert_eq!(parse("resume"), Ok(Command::Resume));
+        assert_eq!(parse("quit"), Ok(Command::Quit));
+        assert_eq!(parse("inject glider"), Ok(Command::Inject { name: "glider".into(), at: None, edge: None }));
+        assert_eq!(
+            parse("inject lwss --at 10 20 --edge left"),
+            Ok(Command::Inject { name: "lwss".into(), at: Some((10, 20)), edge: Some("left".into()) })
+        );
+        assert_eq!(
+            parse("inject text \"hi there\" --at 1 2"),
+            Ok(Command::Inject { name: "text=hi there".into(), at: Some((1, 2)), edge: None })
+        );
+        assert_eq!(parse("inject text hello world"), Ok(Command::Inject { name: "text=hello world".into(), at: None, edge: None }));
+        assert_eq!(parse("reseed --rule highlife --density 0.3"), Ok(Command::Reseed { rule: Some("highlife".into()), density: Some("0.3".into()) }));
+        assert_eq!(parse("reseed"), Ok(Command::Reseed { rule: None, density: None }));
+        assert_eq!(parse("set glow 0.4"), Ok(Command::Set("glow".into(), "0.4".into())));
+        assert_eq!(parse("set audio_command pw-cat --raw"), Ok(Command::Set("audio_command".into(), "pw-cat --raw".into())));
+        assert_eq!(parse("load scene night"), Ok(Command::LoadScene("night".into())));
+        assert_eq!(parse("save scene night"), Ok(Command::SaveScene("night".into())));
+    }
