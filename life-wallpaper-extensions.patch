+
+/// How the age of a live cell maps to a colour.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum AgeShading {
+    /// Four flat classes (newborn, mature, old, ancient). The original look.
+    Steps,
+    /// A continuous gradient through the same colours.
+    Smooth,
+}
+
+/// Features that low-power mode switches off (`battery_disable`).
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub struct Disable {
+    pub traffic: bool,
+    pub guns: bool,
+    pub stamps: bool,
+    pub audio: bool,
+    pub patterns: bool,
+}
+
+impl Disable {
+    pub const ALL: Disable = Disable { traffic: true, guns: true, stamps: true, audio: true, patterns: true };
+
+    pub fn parse(s: &str) -> Result<Self, String> {
+        let mut d = Disable::default();
+        for item in s.split(',').map(|x| x.trim().trim_matches('"')).filter(|x| !x.is_empty()) {
+            match item.to_ascii_lowercase().as_str() {
+                "traffic" => d.traffic = true,
+                "guns" => d.guns = true,
+                "stamps" => d.stamps = true,
+                "audio" => d.audio = true,
+                "patterns" => d.patterns = true,
+                "none" => {}
+                _ => return Err(format!("unknown feature {item:?} in battery_disable (traffic, guns, stamps, audio, patterns)")),
+            }
+        }
+        Ok(d)
+    }
+
+    pub fn list(&self) -> String {
+        let mut v = Vec::new();
+        for (on, name) in [(self.traffic, "traffic"), (self.guns, "guns"), (self.stamps, "stamps"), (self.audio, "audio"), (self.patterns, "patterns")] {
+            if on {
+                v.push(name);
+            }
+        }
+        if v.is_empty() {
+            "none".into()
+        } else {
+            v.join(",")
+        }
+    }
+}
+
