+    #[test]
+    fn beats_events_and_injections_share_one_clock() {
+        let cfg = quiet_cfg();
+        let t0 = Instant::now();
+        let mut s = Sim::new(120, 80, t0, &cfg);
+        s.life.clear();
+        s.on_beat(0.3, t0);
+        let after_beat = s.life.population();
